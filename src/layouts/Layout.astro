---
interface Props {
  title: string;
  description?: string;
  /** Immagine per l'anteprima social, path assoluto dal root del sito. */
  image?: string;
  /** og:type: "website" per gli indici, "article" per la scheda locale. */
  ogType?: "website" | "article";
  /** true sulle pagine che non devono finire su Google (admin, intake). */
  noindex?: boolean;
}
const {
  title,
  description,
  image,
  ogType = "website",
  noindex = false,
} = Astro.props;

// URL canonico assoluto: senza questo Google puo' indicizzare varianti
// della stessa pagina (con/senza slash, con query di tracking) come duplicati.
// In build il pathname porta l'estensione del file generato (.html, per via
// di build.format "file"): va tolta, altrimenti il canonical punta a un
// indirizzo diverso da quello linkato e messo in sitemap.
const canonicalPath =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/(^|\/)index$/, "")
    .replace(/\/+$/, "") || "/";
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, nofollow"
          : "index, follow, max-image-preview:large, max-snippet:-1"
      }
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1f5564" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Aperitivi Urbani" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style is:global>
      :root {
        --teal: #3a8fa0;
        --teal-dark: #1f5564;
        --cream: #fbf5ec;
        --cream-border: #e8dcc8;
        --ink: #1b3942;
        --muted: #6b7280;
        --accent: #d9622e;
        --accent-soft: #f2c57c;
        --white: #ffffff;
        --warn-bg: #fff3cd;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        color: var(--white);
        background: var(--teal);
        line-height: 1.6;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3, h4 {
        font-family: "Fraunces", Georgia, serif;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.2;
      }
      a { color: var(--accent-soft); text-decoration: none; }
      a:hover { text-decoration: underline; }

      header.site {
        background: var(--teal-dark);
        padding: 1.5rem 2rem;
      }
      header.site p {
        margin: 0.25rem 0 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.95rem;
      }
      /* Il nome del sito non e' piu' un <h1>: l'h1 di ogni pagina e' il suo
         titolo reale (nome del locale, ecc.), che e' il segnale che conta
         per la ricerca. Qui restano solo gli stili tipografici. */
      header.site .brand {
        font-family: "Fraunces", Georgia, serif;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
        font-size: 1.5rem;
      }
      header.site .brand a {
        color: var(--white);
      }
      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem;
      }
      footer.site {
        background: var(--teal-dark);
        padding: 2rem;
        text-align: center;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.85rem;
        margin-top: 4rem;
      }
      footer.site a { color: var(--accent-soft); }

      /* Card su crema */
      .card {
        background: var(--cream);
        color: var(--ink);
        border: 1px solid var(--cream-border);
        border-radius: 10px;
        padding: 1.25rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
      }
      .card a { color: var(--ink); }
      .card .muted { color: var(--muted); }
      .card-link {
        display: block;
        text-decoration: none;
      }
      .card-link:hover {
        text-decoration: none;
      }
      .stars { color: var(--accent); font-weight: 600; }

      @media (max-width: 640px) {
        main { padding: 1.25rem; }
        header.site { padding: 1.25rem; }
        header.site .brand { font-size: 1.3rem; }
      }
    </style>
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "483a9a30282c4fdb95a8bfde2de693cb"}'></script>
  </head>
  <body>
    <header class="site">
      <p class="brand"><a href="/">Aperitivi Urbani</a></p>
      <p>Le recensioni di locali milanesi di Valeria Carbone</p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <p>Contenuti riprodotti su licenza dell'autrice — <a href="https://www.instagram.com/aperitivi_urbani/">@aperitivi_urbani</a></p>
    </footer>
  </body>
</html>
