---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const locali = await getCollection("locali");
  return locali.map((loc) => ({
    params: { slug: loc.data.slug },
    props: { loc },
  }));
}

const { loc } = Astro.props;
const { Content } = await render(loc);
const visiteOrdinate = [...loc.data.visite].sort((a, b) => b.data.localeCompare(a.data));

// z.string().url() di Zod accetta "javascript:alert(1)": per il parser WHATWG
// e' una URL sintatticamente valida. Renderizzata in href e' XSS, e la CSP non
// aiuta perche' script-src ha 'unsafe-inline'. Allowlist esplicita di http/https
// prima di renderizzare qualunque link che arrivi dal frontmatter.
function isSafeHttpUrl(u: unknown): boolean {
  if (typeof u !== "string" || !u.trim()) return false;
  try {
    const p = new URL(u).protocol;
    return p === "http:" || p === "https:";
  } catch {
    return false;
  }
}

function starsStr(v: number): string {
  const full = Math.floor(v);
  const half = v - full >= 0.5 ? 1 : 0;
  return "★".repeat(full) + (half ? "½" : "") + "☆".repeat(5 - full - half);
}
const d = loc.data;
const citta = d.citta || "Milano";
const zona = d.zona || citta;
const canonical = new URL(`/locali/${d.slug}`, Astro.site).href;
const fotoAssolute = (d.foto ?? []).map(
  (f) => new URL(`/images/locali/${d.slug}/${f}`, Astro.site).href
);
const ultimaData = visiteOrdinate[0]?.data ?? null;

// Title e description: sono cio' che Google mostra in SERP. Prima erano
// generici ("Recensione di X a Y"), ora contengono zona, tipo di cucina,
// fascia di prezzo e voto — cioe' i termini con cui la gente cerca.
const luogo = zona === citta ? citta : `${zona}, ${citta}`;
const seoTitle = `${d.nome} — ${luogo} | Aperitivi Urbani`;
const seoDescription = [
  `${d.nome}, ${luogo}`,
  (d.tipo ?? []).length > 0 ? (d.tipo ?? []).join(", ") : null,
  d.fascia_prezzo,
  d.voto_dedotto != null ? `voto ${d.voto_dedotto}/5` : null,
]
  .filter(Boolean)
  .join(" · ")
  .slice(0, 150)
  .concat(". Recensione, foto e indirizzo.");

// Dati strutturati Restaurant + Review: sono cio' che rende la scheda
// eleggibile ai rich result (stelle, prezzo, indirizzo) nei risultati Google.
// Volutamente NIENTE aggregateRating: e' una recensione singola d'autore,
// e un aggregateRating finto e' motivo di penalizzazione.
const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: d.nome,
  url: canonical,
  ...(fotoAssolute.length > 0 ? { image: fotoAssolute } : {}),
  address: {
    "@type": "PostalAddress",
    ...(d.indirizzo ? { streetAddress: d.indirizzo } : {}),
    addressLocality: citta,
    addressCountry: "IT",
  },
  ...(d.lat != null && d.lng != null
    ? { geo: { "@type": "GeoCoordinates", latitude: d.lat, longitude: d.lng } }
    : {}),
  ...((d.tipo ?? []).length > 0 ? { servesCuisine: d.tipo } : {}),
  ...(d.fascia_prezzo ? { priceRange: d.fascia_prezzo } : {}),
  ...(d.voto_dedotto != null
    ? {
        review: {
          "@type": "Review",
          author: { "@type": "Person", name: "Aperitivi Urbani" },
          publisher: { "@type": "Organization", name: "Aperitivi Urbani" },
          ...(ultimaData ? { datePublished: ultimaData } : {}),
          reviewRating: {
            "@type": "Rating",
            ratingValue: d.voto_dedotto,
            bestRating: 5,
            worstRating: 1,
          },
        },
      }
    : {}),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Tutti i locali",
      item: new URL("/", Astro.site).href,
    },
    { "@type": "ListItem", position: 2, name: d.nome, item: canonical },
  ],
};

// `<` va sempre escapato dentro <script>: un nome di locale con "<"
// chiuderebbe il tag e trasformerebbe i dati in markup.
const ldJson = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
---

<Layout
  title={seoTitle}
  description={seoDescription}
  ogType="article"
  image={(d.foto ?? []).length > 0 ? `/images/locali/${d.slug}/${d.foto[0]}` : undefined}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ldJson(jsonLd)} />
    <script type="application/ld+json" set:html={ldJson(breadcrumbLd)} />
  </Fragment>
  <p><a href="/" style="color:var(--accent-soft)">← tutti i locali</a></p>

  <article class="card scheda">
    <h1 style="margin:0 0 0.25rem;font-size:1.6rem">{loc.data.nome}</h1>
    <p class="muted" style="margin-top:0">
      {loc.data.zona || "Milano"}
      {loc.data.indirizzo && <> · {loc.data.indirizzo}</>}
      {loc.data.tipo.length > 0 && <> · {loc.data.tipo.join(", ")}</>}
      {loc.data.fascia_prezzo && <> · {loc.data.fascia_prezzo}</>}
    </p>

    {loc.data.voto_dedotto != null && (
      <p class="stars" style="font-size:1.3rem;margin:0.5rem 0">
        {starsStr(loc.data.voto_dedotto)}
      </p>
    )}

    {loc.data.sponsorizzato && (
      <p style="background:var(--warn-bg);border-left:3px solid var(--accent);padding:0.6rem 1rem;font-size:0.9rem;border-radius:4px">
        Contenuto sponsorizzato / in collaborazione (come dichiarato nel post originale)
      </p>
    )}

    {loc.data.foto && loc.data.foto.length > 0 && (
      <div class="gallery" style="margin:1rem 0">
        <div style="position:relative">
          <img
            id="gallery-hero-img"
            src={`/images/locali/${loc.data.slug}/${loc.data.foto[0]}`}
            alt={`${loc.data.nome} — ${luogo}`}
            style="width:100%;aspect-ratio:4/3;object-fit:cover;object-position:center;border-radius:10px;display:block;image-rendering:auto"
          />
          {loc.data.foto.length > 1 && (
            <div id="gallery-counter" style="position:absolute;bottom:8px;right:8px;background:rgba(27,57,66,0.55);color:#fff;font-size:0.75rem;padding:0.15rem 0.6rem;border-radius:999px">
              1 / {loc.data.foto.length}
            </div>
          )}
        </div>
        {loc.data.foto.length > 1 && (
          <div style="display:flex;gap:0.4rem;margin-top:0.5rem;overflow-x:auto">
            {loc.data.foto.map((f, i) => (
              <img
                class="gallery-thumb"
                data-index={i}
                data-full={`/images/locali/${loc.data.slug}/${f}`}
                src={`/images/locali/${loc.data.slug}/${f}`}
                alt=""
                loading="lazy"
                decoding="async"
                style={`width:56px;height:56px;object-fit:cover;object-position:center;border-radius:6px;cursor:pointer;flex:0 0 auto;border:2px solid ${i === 0 ? "var(--accent)" : "transparent"};image-rendering:auto`}
              />
            ))}
          </div>
        )}
      </div>
    )}

    {loc.data.foto && loc.data.foto.length > 1 && (
      <script is:inline define:vars={{ totale: loc.data.foto.length }}>
        (function() {
          var hero = document.getElementById('gallery-hero-img');
          var counter = document.getElementById('gallery-counter');
          var thumbs = document.querySelectorAll('.gallery-thumb');
          thumbs.forEach(function(t) {
            t.addEventListener('click', function() {
              hero.src = t.getAttribute('data-full');
              thumbs.forEach(function(other) {
                other.style.border = '2px solid transparent';
              });
              t.style.border = '2px solid var(--accent)';
              if (counter) {
                counter.textContent = (parseInt(t.getAttribute('data-index'), 10) + 1) + ' / ' + totale;
              }
            });
          });
        })();
      </script>
    )}


    <section>
      <h3>Visite</h3>
      {visiteOrdinate.map((v) => (
        <article style="border-top:1px solid var(--cream-border);padding:1rem 0">
          <p class="muted" style="font-size:0.9rem;margin:0 0 0.5rem">
            {v.data}
            {v.fonte_tipo === "lista" && <span style="margin-left:0.5rem;background:var(--accent-soft);color:var(--ink);font-size:0.7rem;padding:0.1rem 0.45rem;border-radius:4px">da post-lista</span>}
            {isSafeHttpUrl(v.post_url) && (
              <>{" · "}<a href={v.post_url} rel="noopener" style="color:var(--accent)">post originale ↗</a></>
            )}
          </p>
          {v.foto.length > 0 && (
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.75rem">
              {v.foto.map((f) => <img src={f} alt="" loading="lazy" decoding="async" style="width:240px;max-width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:6px;flex-shrink:0" />)}
            </div>
          )}
          <p style="white-space:pre-line">{v.caption}</p>
        </article>
      ))}
    </section>

    {loc.data.indirizzo && (
      <section style="margin-top:2rem">
        <h3>Dove si trova</h3>
        <p class="muted" style="font-size:0.95rem;margin-bottom:0.75rem">
          {loc.data.indirizzo}{loc.data.citta ? `, ${loc.data.citta}` : ""}
        </p>
        <div style="border-radius:10px;overflow:hidden;border:1px solid var(--cream-border)">
          <iframe
            width="100%"
            height="380"
            style="border:0;display:block"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps/embed/v1/place?key=${import.meta.env.GOOGLE_MAPS_API_KEY}&q=${encodeURIComponent((loc.data.indirizzo ?? "") + ", " + (loc.data.citta ?? "Milano"))}`}
          ></iframe>
        </div>
      </section>
    )}

    <section style="margin-top:2rem">
      <Content />
    </section>
  </article>
</Layout>

<style>
  .scheda { padding: 1.75rem; }
  .scheda h3 { margin-top: 1.5rem; }
  @media (max-width: 640px) {
    .scheda { padding: 1.25rem; }
  }
</style>
